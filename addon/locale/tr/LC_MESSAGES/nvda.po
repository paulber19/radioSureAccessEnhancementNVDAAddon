#. Translators: The progress message
#. indicating the name of the add-on being downloaded.
#: globalPlugins\radioSureAccessEnhancement\updateHandler\update_check.py:86
msgid "Downloading {name}"
msgstr "{name} indiriliyor"

#. Translators: A message indicating that an error occurred
#. while downloading an update to NVDA.
#: globalPlugins\radioSureAccessEnhancement\updateHandler\update_check.py:101
msgid "Error downloading update for {name}."
msgstr "{name} İçin güncelleme indirilirken hata oluştu."

#. Translators: message to user
#: globalPlugins\radioSureAccessEnhancement\updateHandler\update_check.py:155
msgid "Cannot update {name} - missing file or invalid file format"
msgstr "{name} Güncellenemiyor - eksik dosya veya geçersiz dosya biçimi"

#. Translators: The title of the dialog
#. presented while an Addon is being updated.
#: globalPlugins\radioSureAccessEnhancement\updateHandler\update_check.py:172
msgid "Updating"
msgstr "Güncelleniyor"

#. Translators: The message displayed while an addon is being updated.
#: globalPlugins\radioSureAccessEnhancement\updateHandler\update_check.py:174
msgid "Please wait while the add-on is being updated."
msgstr "Eklenti güncellenirken lütfen bekleyin."

#. Translators: The message displayed when an error occurs
#. when installing an add-on package.
#: globalPlugins\radioSureAccessEnhancement\updateHandler\update_check.py:196
msgid "Failed to update {name} add-on"
msgstr "{name} eklentisi güncellenemedi"

#: globalPlugins\radioSureAccessEnhancement\updateHandler\update_check.py:248
msgid "{summary} - update"
msgstr "{summary} - güncelleme"

#: globalPlugins\radioSureAccessEnhancement\updateHandler\update_check.py:258
msgid "The service is temporarily under maintenance. Please, try again later."
msgstr "Hizmet geçici olarak bakımda. Lütfen daha sonra tekrar dene."

#: globalPlugins\radioSureAccessEnhancement\updateHandler\update_check.py:286
msgid ""
"The update is not compatible with this version of NVDA. Minimum NVDA "
"version: {minYear}.{minMajor}, last tested: {testedYear}.{testedMajor}."
msgstr ""
"Güncelleme, NVDA'nın bu sürümüyle uyumlu değil. Minimum NVDA sürümü: "
"{minYear}.{minMajor}, son sınama: {testedYear}.{testedMajor}."

#. Translators: message to user to report a new version.
#: globalPlugins\radioSureAccessEnhancement\updateHandler\update_check.py:330
#, python-format
msgid "New version%s is available. Do you want to download it now?"
msgstr "Yeni sürüm, %s mevcut. Şimdi indirmek ister misiniz?"

#: globalPlugins\radioSureAccessEnhancement\updateHandler\update_check.py:334
msgid ""
"New version{0} is available.\n"
"But it is not compatible with this version of NVDA: minimum version requred "
"= {1}, last version tested  = {2}.\n"
"Do you want to ignore this incompatibility and still download it now?"
msgstr ""
"Yeni sürüm{0} mevcut.\n"
"Ancak NVDA'nın bu sürümüyle uyumlu değil: gereken minimum sürüm = {1}, test "
"edilen son sürüm = {2}.\n"
"Bu uyumsuzluğu görmezden gelerek Eklentiyi şimdi indirmeye devam etmek "
"istiyor musunuz?"

#: globalPlugins\radioSureAccessEnhancement\updateHandler\update_check.py:354
#, python-format
msgid "You are up-to-date. %s is the latest version."
msgstr "Güncelsin. %s en son sürüm."

#: globalPlugins\radioSureAccessEnhancement\updateHandler\update_check.py:361
msgid "Oops! There was a problem checking for updates. Please retry later"
msgstr ""
"Hata! Güncellemeler kontrol edilirken bir sorun oluştu. Lütfen daha sonra "
"tekrar dene"

