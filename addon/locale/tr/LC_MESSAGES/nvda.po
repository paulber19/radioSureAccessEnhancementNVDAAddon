msgstr "Sesi hafifçe azalt (%3)"

#. Translators: Input help mode message for increase Slightly Volume command.
#: appModules\radioSure\__init__.py:485
msgid "Increase slightly the volume(up 3%)"
msgstr "Sesi hafifçe artır (%3)"

