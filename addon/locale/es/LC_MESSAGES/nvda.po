msgid "{summary} - update"
msgstr "{summary} - actualización"

#: globalPlugins/radioSureAccessEnhancement/updateHandler/update_check.py:348
msgid "The service is temporarily under maintenance. Please, try again later."
msgstr ""
"El servicio está actualmente en mantenimiento. Por favor, inténtelo de nuevo "
"más tarde."

#: globalPlugins/radioSureAccessEnhancement/updateHandler/update_check.py:375
#, python-brace-format
msgid ""
"The update is not compatible with this version of NVDA. Minimum NVDA "
"version: {minYear}.{minMajor}, last tested: {testedYear}.{testedMajor}."
msgstr ""
"La actualización no es compatible con esta versión de NVDA. Versión mínima "
"de NVDA: {minYear}.{minMajor}, última probada: {testedYear}.{testedMajor}."

#: globalPlugins/radioSureAccessEnhancement/updateHandler/update_check.py:434
#, python-format
msgid "New version%s is available. Do you want to download it now?"
msgstr "La nueva versión %s está disponible. ¿Quieres descargarla ahora?"

#: globalPlugins/radioSureAccessEnhancement/updateHandler/update_check.py:438
#, python-brace-format
msgid ""
"New version{0} is available.\n"
"But it is not compatible with this version of NVDA: minimum version requred "
"= {1}, last version tested  = {2}.\n"
"Do you want to ignore this incompatibility and still download it now?"
msgstr ""
"La nueva versión{0} está disponible.\\n\n"
"Pero no es compatible con esta versión de NVDA: versión mínima requerida = "
"{1}, última versión probada = {2}.\\n\n"
"¿Quieres ignorar esta incompatibilidad y aún así descargarla ahora?"

#: globalPlugins/radioSureAccessEnhancement/updateHandler/update_check.py:459
#, python-format
msgid "You are up-to-date. %s is the latest version."
msgstr "Estás al día, %s es la versión más reciente."

#: globalPlugins/radioSureAccessEnhancement/updateHandler/update_check.py:466
msgid "Oops! There was a problem checking for updates. Please retry later"
msgstr ""
"¡Huy! Hubo un problema al buscar las actualizaciones. Por favor, inténtelo "
"de nuevo más tarde"

#: globalPlugins/radioSureAccessEnhancement/updateHandler/update_check.py:621
msgid "&Yes"
msgstr "&Sí"

#: globalPlugins/radioSureAccessEnhancement/updateHandler/update_check.py:626
