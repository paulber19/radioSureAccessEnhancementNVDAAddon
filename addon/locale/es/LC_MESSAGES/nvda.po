msgstr ""
"No se puede actualizar {name} - archivo ausente o formato de archivo no "
"válido"

#: globalPlugins/radioSureAccessEnhancement/updateHandler/update_check.py:267
msgid "Updating"
msgstr "Actualizando"

#: globalPlugins/radioSureAccessEnhancement/updateHandler/update_check.py:269
msgid "Please wait while the add-on is being updated."
msgstr "Por favor, espera mientras se actualiza el complemento."

#: globalPlugins/radioSureAccessEnhancement/updateHandler/update_check.py:291
#, python-brace-format
msgid "Failed to update {name} add-on"
msgstr "Fallo al actualizar el complemento {name}"

